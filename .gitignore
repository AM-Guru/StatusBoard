# ─── macOS ────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# ─── Xcode ────────────────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
DerivedData/
build/
Build/
.swiftpm/
timeline.xctimeline
playground.xcworkspace

# The Xcode project is generated from project.yml by XcodeGen — regenerate it
# with `xcodegen generate` rather than committing it.
StatusBoard.xcodeproj/

# Info.plist and .entitlements files are likewise generated by XcodeGen.
Apps/**/Info*.plist
Apps/**/*.entitlements

# ─── Swift Package Manager ────────────────────────────────────────────────
.build/
Packages/*/.build/
.netrc
Package.resolved

# ─── Signing and secrets — never commit these ─────────────────────────────
*.p8
*.p12
*.mobileprovision
*.provisionprofile
*.cer
*.certSigningRequest
.env
.env.*
!.env.example
ExportOptions.local.plist
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# ─── Release artifacts ────────────────────────────────────────────────────
Artifacts/
*.xcarchive
*.app.zip
*.pkg

# ─── Editors and tooling ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.claude/
